# Folder that holds your CV, and the CV file name inside it. Mounted read-only.
JOBHUNT_CV_DIR=/path/to/folder
JOBHUNT_CV_NAME=CV.pdf
# DeepL API Free key (https://www.deepl.com/pro-api); leave empty to skip translation
DEEPL_AUTH_KEY=
# Linux only, when your user id isn't 1000 (check with `id -u` and `id -g`): the app writes ./data as this user
# JOBHUNT_UID=1000
# JOBHUNT_GID=1000
